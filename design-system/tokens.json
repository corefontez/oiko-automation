{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "brand": "Oiko Automation",
    "version": "1.0.0",
    "description": "Design tokens oficiais da Oiko Automation"
  },

  "color": {
    "bg": {
      "primary":   { "value": "#151821", "comment": "Background principal da página" },
      "secondary": { "value": "#1D212B", "comment": "Superfícies elevadas: cards, navbar, FAQ" }
    },
    "brand": {
      "primary":     { "value": "#EA580C", "comment": "CTA, botões, destaques, ícones" },
      "primaryHover":{ "value": "#F97316", "comment": "Hover de botões e interações" },
      "accentSoft":  { "value": "#FDBA74", "comment": "Glow suave, badges, micro-detalhes" }
    },
    "text": {
      "primary":   { "value": "#F5F7FB", "comment": "Títulos e texto de alto contraste" },
      "secondary": { "value": "#A7AEC1", "comment": "Descrições, subtítulos, body" },
      "muted":     { "value": "#7D8597", "comment": "Labels, placeholders, infos secundárias" }
    },
    "ui": {
      "border": { "value": "#2A2F3A", "comment": "Bordas de cards, inputs, divisores" }
    }
  },

  "shadow": {
    "soft":         { "value": "0 8px 30px rgba(0,0,0,0.18)" },
    "card":         { "value": "0 4px 24px rgba(0,0,0,0.28)" },
    "elevated":     { "value": "0 16px 48px rgba(0,0,0,0.35)" },
    "glowPrimary":  { "value": "0 0 24px rgba(234,88,12,0.18)" },
    "glowStrong":   { "value": "0 0 40px rgba(234,88,12,0.30)" },
    "glowSubtle":   { "value": "0 0 16px rgba(234,88,12,0.10)" }
  },

  "borderRadius": {
    "xs":        { "value": "8px",  "comment": "Elementos UI pequenos" },
    "sm":        { "value": "12px", "comment": "Elementos genéricos" },
    "button":    { "value": "14px", "comment": "Botões" },
    "input":     { "value": "16px", "comment": "Inputs e FAQ" },
    "card":      { "value": "20px", "comment": "Cards de serviço e conteúdo" },
    "container": { "value": "24px", "comment": "Containers e blocos" },
    "feature":   { "value": "28px", "comment": "Blocos de feature grandes" },
    "hero":      { "value": "32px", "comment": "CTA block, hero glass" }
  },

  "typography": {
    "fontFamily": {
      "primary": { "value": "'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
    },
    "fontSize": {
      "displayXl": { "value": "72px" },
      "displayL":  { "value": "60px" },
      "h1":        { "value": "52px" },
      "h2":        { "value": "40px" },
      "h3":        { "value": "28px" },
      "h4":        { "value": "22px" },
      "bodyXl":    { "value": "20px" },
      "bodyL":     { "value": "18px" },
      "bodyM":     { "value": "16px" },
      "bodyS":     { "value": "14px" },
      "label":     { "value": "14px" },
      "caption":   { "value": "13px" },
      "button":    { "value": "16px" },
      "nav":       { "value": "16px" }
    },
    "fontWeight": {
      "regular":   { "value": 400 },
      "medium":    { "value": 500 },
      "semibold":  { "value": 600 },
      "bold":      { "value": 700 },
      "extrabold": { "value": 800 }
    },
    "lineHeight": {
      "display": { "value": 1.05 },
      "h1":      { "value": 1.08 },
      "h2":      { "value": 1.12 },
      "h3":      { "value": 1.20 },
      "h4":      { "value": 1.25 },
      "bodyXl":  { "value": 1.65 },
      "bodyL":   { "value": 1.70 },
      "bodyM":   { "value": 1.70 },
      "bodyS":   { "value": 1.60 }
    },
    "letterSpacing": {
      "display": { "value": "-0.030em" },
      "h1":      { "value": "-0.025em" },
      "h2":      { "value": "-0.020em" },
      "h3":      { "value": "-0.015em" },
      "h4":      { "value": "-0.010em" },
      "body":    { "value": "-0.005em" },
      "label":   { "value": "0.040em" }
    },
    "mobileScale": {
      "displayXl": { "value": "42px" },
      "h1":        { "value": "36px" },
      "h2":        { "value": "30px" },
      "h3":        { "value": "24px" },
      "bodyXl":    { "value": "18px" },
      "bodyM":     { "value": "15px" }
    }
  },

  "spacing": {
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" },
    "10": { "value": "40px" },
    "12": { "value": "48px" },
    "16": { "value": "64px" },
    "20": { "value": "80px" },
    "24": { "value": "96px" },
    "30": { "value": "120px" }
  },

  "layout": {
    "maxWidth":          { "value": "1280px" },
    "contentWidth":      { "value": "1200px" },
    "paddingXDesktop":   { "value": "48px" },
    "paddingXTablet":    { "value": "32px" },
    "paddingXMobile":    { "value": "24px" },
    "navHeight":         { "value": "72px" },
    "sectionPaddingY":   { "value": "120px" }
  },

  "animation": {
    "easeOut":   { "value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "easeInOut": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "durationXs": { "value": "100ms" },
    "durationSm": { "value": "180ms" },
    "durationMd": { "value": "280ms" },
    "durationLg": { "value": "420ms" }
  }
}
